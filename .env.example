# Main LLM (orchestrator agent, Strands) - Amazon Bedrock
# Option A: bearer token (Bedrock API key) - takes priority if present
AWS_BEARER_TOKEN_BEDROCK=
# Option B: classic access/secret key pair (if no bearer token)
AWS_PUBLIC_KEY_BEDROCK=
AWS_PRIVATE_KEY_BEDROCK=
AWS_REGION_BEDROCK=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-5-5

# research_with_sonar tool (Perplexity Sonar)
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar-reasoning-pro

# search_web tool
WEB_SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
BRAVE_API_KEY=
WEB_SEARCH_MAX_RESULTS=5

# search_knowledge_base tool
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=grounded_search_docs
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
KB_MAX_RESULTS=5
# Minimum Qdrant similarity for a passage to be returned (empty = no threshold)
KB_MIN_SCORE=

# Corrective RAG: grade the knowledge-base passages, fall back to the web when they aren't relevant
KB_RELEVANCE_GRADING=true
# Context precision above this counts as relevant
KB_RELEVANCE_THRESHOLD=0.5
# Grader model (empty = BEDROCK_MODEL_ID)
KB_RELEVANCE_MODEL_ID=

# search_research_cache tool (same Qdrant instance, separate collection)
RESEARCH_CACHE_COLLECTION=grounded_search_cache
RESEARCH_CACHE_MAX_RESULTS=3
RESEARCH_CACHE_MIN_SCORE=0.75

# Hooks
# Block search_web / research_with_sonar until search_research_cache was called
ENFORCE_CACHE_FIRST=true
# Log every agent-loop step (model turns, tool calls, results) to the console
LIVE_LOG=true
# DEBUG also shows Strands' own internal logs
LOG_LEVEL=INFO

# Human-in-the-loop (interrupts), both on by default
# Pause before the tools below run and wait for y (once) / t (trust for the session) / n or feedback
HITL_APPROVAL=true
HITL_APPROVAL_TOOLS=search_web,research_with_sonar
# Register the ask_user tool: the agent can pause to ask you a clarifying question
HITL_CLARIFY=true
# Persist conversation + agent state (trusted tools) across runs (empty = no persistence)
SESSION_ID=
SESSION_DIR=.sessions

# Observability (OpenTelemetry)
# One JSON span per line, appended to this file (empty to disable)
OTEL_TRACES_FILE=traces.jsonl
# Also print raw spans to stdout (very verbose)
OTEL_CONSOLE_EXPORT=false
# Langfuse / OTLP below require: pip install -e ".[otel]"
# Option A: Langfuse (takes priority if both keys are set)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
# Option B: any OTLP backend (Arize Phoenix, Jaeger, collector...), e.g. http://localhost:6006/v1/traces
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
